{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": {
            "hypergraft/browser": ["./browser/index.ts"]
        }
    },
    "include": [
        "browser/**/*.ts",
        "vitest*.ts",
        "examples/reference/browser/**/*.ts",
        "examples/reference/vite.config.ts"
    ]
}
